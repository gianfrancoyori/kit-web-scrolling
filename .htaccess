# ── PHP 8.2 (selector cPanel EA4) ──
AddHandler application/x-httpd-ea-php82 .php

RewriteEngine On

# ── HTTPS + www canónico ──
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^rapidtransfer\.cl$ [NC]
RewriteRule ^(.*)$ https://www.rapidtransfer.cl/$1 [R=301,L]

# ── /index.php e /index.html → / ──
RewriteCond %{THE_REQUEST} \s/index\.(php|html)[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ── /pagina.html o /pagina.php → /pagina (URLs limpias) ──
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.(html|php)[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ /%1 [R=301,L]

# ── Servir el .php cuando se pide la URL limpia ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [L]

# ── Bloquear acceso directo a includes/ ──
RewriteRule ^includes/ - [F,L]

# ── Página 404 ──
ErrorDocument 404 /404.php

# ── Headers de seguridad ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML: revalidar siempre (no-cache permite usar el cache tras validar)
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Assets estáticos: cache larga (se versionan con ?v= en el HTML)
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
